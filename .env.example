# ─────────────────────────────────────────────────────────────────────────────
# OpenRoles environment. Copy to `.env.local` and fill in real values.
# Everything here has a permanent free tier — no credit card required
# (Resend is the only optional exception, and email works in "log" mode without it).
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (Project Settings -> API) -------------------------------------
# You (the user) create the project and paste these three values yourself.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (https://aistudio.google.com/apikey — free, no card) -----
GEMINI_API_KEY=
# Model used for company resolution + bespoke-page extraction.
GEMINI_MODEL=gemini-2.5-flash
# Hard daily ceiling on AI calls to stay inside the free tier. Above this the
# app degrades gracefully to "structured sources only".
AI_DAILY_CALL_BUDGET=800

# --- On-demand fetch offload (optional) ------------------------------------
# A GitHub Personal Access Token with the `workflow` scope, used only as a
# fallback when an inline live-fetch would exceed the serverless time limit.
# Leave blank to always process inline.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=your-github-username/job-platform

# --- Shared secrets -------------------------------------------------------
# Protects /api/cron/* and /api/health from public abuse. Any long random string.
CRON_SECRET=

# --- Email digests (optional — https://resend.com, free 3k/mo) ------------
RESEND_API_KEY=
ALERTS_FROM_EMAIL=OpenRoles <alerts@example.com>

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact URL advertised in the scraper User-Agent (be a good web citizen).
SCRAPER_CONTACT_URL=https://github.com/your-github-username/job-platform
